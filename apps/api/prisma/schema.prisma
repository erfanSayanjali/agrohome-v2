generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  AVAILABLE
  UNAVAILABLE
}

enum BlogStatus {
  published
  draft
}

enum SpecPosition {
  attribute
  extra
}

enum CommentTargetType {
  product
  blog
  comment
}

enum CmsPageStatus {
  draft
  published
  archived
}

enum BlockOwnerType {
  PAGE
}

/// STATIC: UI fields in payload
/// ENTITY_QUERY: { entity, filters, sort, limit, select? }
/// ENTITY_REF: { entity, ids: string[] }
enum BlockSourceType {
  STATIC
  ENTITY_QUERY
  ENTITY_REF
}

model Role {
  id          String   @id @default(cuid())
  legacyId    String?  @unique
  title       String
  permissions Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id           String   @id @default(cuid())
  legacyId     String?  @unique
  phone        String   @unique
  firstName    String?
  lastName     String?
  nickname     String?
  media        Json?
  passwordHash String?
  roleId       String?
  role         Role?    @relation(fields: [roleId], references: [id])
  blogs        Blog[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model OtpChallenge {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, expiresAt])
  @@index([phone, consumed, expiresAt])
}

model ProductCategory {
  id          String            @id @default(cuid())
  legacyId    String?           @unique
  title       String
  slug        String            @unique
  description String?
  publish     Boolean           @default(true)
  parentId    String?
  parent      ProductCategory?  @relation("ProductCategoryTree", fields: [parentId], references: [id])
  children    ProductCategory[] @relation("ProductCategoryTree")
  products    ProductCategoryOnProduct[]
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([parentId, publish])
}

model Product {
  id            String                     @id @default(cuid())
  legacyId      String?                    @unique
  title         String
  slug          String                     @unique
  subtitle      String?
  description   String?
  media         Json?
  gallery       Json                       @default("[]")
  isFeatured    Boolean                    @default(false)
  status        ProductStatus              @default(AVAILABLE)
  views         Int                        @default(0)
  sortOrder     Int                        @default(0)
  packages      Package[]
  specs         ProductSpecification[]
  tags          ProductTag[]
  categories    ProductCategoryOnProduct[]
  comments      Comment[]
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@index([status, createdAt])
}

model ProductCategoryOnProduct {
  productId  String
  categoryId String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model Package {
  id        String   @id @default(cuid())
  legacyId  String?  @unique
  value     Float
  unit      String
  sortOrder Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model Specification {
  id        String                 @id @default(cuid())
  legacyId  String?                @unique
  title     String
  position  SpecPosition           @default(attribute)
  values    ProductSpecification[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
}

model ProductSpecification {
  id              String        @id @default(cuid())
  legacyId        String?       @unique
  productId       String
  specificationId String
  value           String
  highlight       Boolean       @default(false)
  sortOrder       Int           @default(0)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  specification   Specification @relation(fields: [specificationId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([productId])
  @@unique([productId, specificationId])
}

model TagCategory {
  id        String   @id @default(cuid())
  legacyId  String?  @unique
  title     String
  slug      String   @unique
  tags      Tag[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id           String      @id @default(cuid())
  legacyId     String?     @unique
  title        String
  slug         String      @unique
  categoryId   String?
  category     TagCategory? @relation(fields: [categoryId], references: [id])
  products     ProductTag[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model BlogCategory {
  id          String         @id @default(cuid())
  legacyId    String?        @unique
  title       String
  slug        String         @unique
  description String?
  publish     Boolean        @default(true)
  media       Json?
  parentId    String?
  parent      BlogCategory?  @relation("BlogCategoryTree", fields: [parentId], references: [id])
  children    BlogCategory[] @relation("BlogCategoryTree")
  blogs       Blog[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([parentId, publish])
}

model Blog {
  id           String        @id @default(cuid())
  legacyId     String?       @unique
  title        String
  slug         String        @unique
  content      String?
  status       BlogStatus    @default(draft)
  media        Json?
  authorId     String?
  author       User?         @relation(fields: [authorId], references: [id])
  categoryId   String?
  category     BlogCategory? @relation(fields: [categoryId], references: [id])
  comments     Comment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([categoryId])
}

model Comment {
  id         String            @id @default(cuid())
  legacyId   String?           @unique
  nickName   String
  content    String
  email      String?
  website    String?
  rating     Float?
  publish    Boolean           @default(false)
  /// نمایش در اسلایدر نظرات صفحه اصلی
  showOnHome Boolean           @default(false)
  targetType CommentTargetType
  productId  String?
  product    Product?          @relation(fields: [productId], references: [id], onDelete: Cascade)
  blogId     String?
  blog       Blog?             @relation(fields: [blogId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     Comment?          @relation("CommentReplies", fields: [parentId], references: [id])
  replies    Comment[]         @relation("CommentReplies")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([publish, showOnHome])
  @@index([productId, publish])
  @@index([blogId, publish])
  @@index([parentId])
}

/// Composable CMS page (/, /about, /contact, custom landings).
model CmsPage {
  id                 String        @id @default(cuid())
  slug               String        @unique
  title              String
  status             CmsPageStatus @default(draft)
  publishedAt        DateTime?
  /// ISR / cache hint for main
  revalidateSeconds  Int           @default(3600)
  /// Structural snapshot of published blocks for fast SSR reads
  publishedSnapshot  Json?
  blocks             ContentBlock[]
  seo                Seo?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status])
}

/// Singleton site branding + header/footer settings (logo, favicon, nav, socials, footer link groups).
model SiteSettings {
  id               String   @id @default("default")
  logoUrl          String?
  faviconUrl       String?
  footerText       String?
  socialLinks      Json     @default("[]")
  headerLinks      Json     @default("[]")
  footerLinkGroups Json     @default("[]")
  updatedAt        DateTime @updatedAt
}

/// Page block (ابزارک). Belongs to a CmsPage via pageId.
/// type examples: hero, rich_text, faq, banner, cta, product_grid, blog_grid,
/// blog_category_grid, comment_list, contact_form, custom
model ContentBlock {
  id         String          @id @default(cuid())
  ownerType  BlockOwnerType  @default(PAGE)
  pageId     String?
  page       CmsPage?        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type       String
  name       String?
  sortOrder  Int             @default(0)
  isVisible  Boolean         @default(true)
  sourceType BlockSourceType @default(STATIC)
  /// STATIC | ENTITY_QUERY | ENTITY_REF payload (see BlockSourceType)
  payload    Json            @default("{}")
  /// In-page section id for deep links / TOC
  anchor     String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([pageId, sortOrder])
  @@index([type, isVisible])
}

model Seo {
  id              String   @id @default(cuid())
  legacyId        String?  @unique
  targetPath      String?
  targetType      String?
  targetLegacyId  String?
  metaTitle       String?
  metaDescription String?
  metaKeyWords    String[] @default([])
  canonicalUrl    String?
  pageId          String?  @unique
  page            CmsPage? @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([targetPath])
  @@index([targetType, targetLegacyId])
}

model Media {
  id        String   @id @default(cuid())
  legacyId  String?  @unique
  url       String
  type      String?
  name      String?
  alt       String?
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([url])
}

model ContactMessage {
  id        String   @id @default(cuid())
  legacyId  String?  @unique
  fullName  String?
  subject   String?
  email     String?
  phone     String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}
